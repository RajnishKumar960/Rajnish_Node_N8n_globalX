{
  "name": "AI Inbound Lead Intelligence Bot (Groq + Company Citizen)",
  "nodes": [
    {
      "parameters": {},
      "id": "c0000000-0000-4000-8000-000000000001",
      "name": "Run Bot",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -40,
        400
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "name",
              "value": "Jordan Rivera",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "email",
              "value": "jordan.rivera@example.com",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "phone",
              "value": "+1 555-0142",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "company",
              "value": "GlobalX Solutions",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "source",
              "value": "website",
              "type": "string"
            },
            {
              "id": "f6",
              "name": "message",
              "value": "Hi, I'm Jordan Rivera from GlobalX Solutions. We're a 50-person services firm and I want to automate our CRM, appointment booking and email follow-ups. Budget is approved and we'd like to start this quarter. Please have someone reach out.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c0000000-0000-4000-8000-000000000002",
      "name": "Incoming Enquiry",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        180,
        400
      ]
    },
    {
      "parameters": {
        "resource": "lead",
        "operation": "create",
        "email": "={{ $json.email }}",
        "additionalFields": {
          "name": "={{ $json.name }}",
          "phone": "={{ $json.phone }}",
          "company": "={{ $json.company }}",
          "source": "={{ $json.source }}",
          "status": "new",
          "notes": "={{ $json.message }}"
        }
      },
      "id": "c0000000-0000-4000-8000-000000000003",
      "name": "Capture Lead",
      "type": "n8n-nodes-company-citizen.companyCitizen",
      "typeVersion": 1,
      "position": [
        400,
        400
      ],
      "credentials": {
        "companyApi": {
          "id": "REPLACE_WITH_COMPANY_CREDENTIAL_ID",
          "name": "Company API"
        }
      }
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-20b",
        "options": {}
      },
      "id": "c0000000-0000-4000-8000-000000000004",
      "name": "Groq Brain",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        620,
        640
      ],
      "credentials": {
        "groqApi": {
          "id": "REPLACE_WITH_GROQ_CREDENTIAL_ID",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "text": "={{ $('Incoming Enquiry').item.json.message }}",
        "attributes": {
          "attributes": [
            {
              "name": "companySize",
              "description": "Approx number of employees or company size mentioned",
              "type": "string"
            },
            {
              "name": "useCase",
              "description": "What the prospect wants to automate or achieve",
              "type": "string"
            },
            {
              "name": "budgetSignal",
              "description": "Budget/approval signal: yes, no, or unknown",
              "type": "string"
            },
            {
              "name": "timeline",
              "description": "Any timeline or urgency mentioned",
              "type": "string"
            },
            {
              "name": "preferredChannel",
              "description": "How they want to be contacted (phone, email, etc.)",
              "type": "string"
            },
            {
              "name": "summary",
              "description": "One-sentence summary of the enquiry",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c0000000-0000-4000-8000-000000000005",
      "name": "Extract Intel",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        620,
        400
      ]
    },
    {
      "parameters": {
        "inputText": "={{ $('Incoming Enquiry').item.json.message }}",
        "categories": {
          "categories": [
            {
              "category": "Hot",
              "description": "Ready to buy: explicit intent, approved budget, urgent timeline, or asks to be contacted now"
            },
            {
              "category": "Warm",
              "description": "Genuinely interested but still exploring; no firm budget or timeline yet"
            },
            {
              "category": "Cold",
              "description": "Low intent, vague, just browsing, or not a real buyer"
            }
          ]
        },
        "options": {}
      },
      "id": "c0000000-0000-4000-8000-000000000006",
      "name": "Classify Priority",
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1,
      "position": [
        860,
        400
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert B2B sales development rep for an automation platform. Write a short, warm, personalized follow-up email (120-150 words) to {{ $('Incoming Enquiry').item.json.name }}, who wrote: \"{{ $('Incoming Enquiry').item.json.message }}\". Reference their goal: {{ $('Extract Intel').item.json.output.useCase }}. Offer a 20-minute discovery call this week. Sign off as the GlobalX Automation Team. Return ONLY the email body, no subject line.",
        "options": {
          "systemMessage": "You are a concise, friendly B2B sales development rep. Never invent pricing or features. Keep the email under 150 words."
        }
      },
      "id": "c0000000-0000-4000-8000-000000000007",
      "name": "Draft Outreach",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1120,
        180
      ]
    },
    {
      "parameters": {
        "resource": "customer",
        "operation": "create",
        "email": "={{ $('Incoming Enquiry').item.json.email }}",
        "additionalFields": {
          "firstName": "={{ ($('Incoming Enquiry').item.json.name || '').split(' ')[0] }}",
          "lastName": "={{ ($('Incoming Enquiry').item.json.name || '').split(' ').slice(1).join(' ') }}",
          "phone": "={{ $('Incoming Enquiry').item.json.phone }}",
          "company": "={{ $('Incoming Enquiry').item.json.company }}",
          "status": "prospect",
          "notes": "={{ 'HOT lead ' + $('Capture Lead').item.json.id + ' — ' + $('Extract Intel').item.json.output.summary }}"
        }
      },
      "id": "c0000000-0000-4000-8000-000000000008",
      "name": "Convert to Customer",
      "type": "n8n-nodes-company-citizen.companyCitizen",
      "typeVersion": 1,
      "position": [
