      "credentials": {
        "companyApi": {
          "id": "REPLACE_WITH_COMPANY_CREDENTIAL_ID",
          "name": "Company API"
        }
      }
    },
    {
      "parameters": {
        "resource": "appointment",
        "operation": "create",
        "title": "={{ 'Discovery call — ' + $('Incoming Enquiry').item.json.name }}",
        "startTime": "={{ $now.plus({ days: 1 }).toISO() }}",
        "additionalFields": {
          "customerId": "={{ $('Convert to Customer').item.json.id }}",
          "location": "={{ 'Phone ' + $('Incoming Enquiry').item.json.phone }}",
          "status": "scheduled"
        }
      },
      "id": "c0000000-0000-4000-8000-000000000009",
      "name": "Book Call",
      "type": "n8n-nodes-company-citizen.companyCitizen",
      "typeVersion": 1,
