    {
      "parameters": {
        "resource": "notification",
        "operation": "sendEmail",
        "to": "={{ $('Incoming Enquiry').item.json.email }}",
        "subject": "={{ 'Thanks ' + ($('Incoming Enquiry').item.json.name || '').split(' ')[0] + ' — a quick next step' }}",
        "body": "={{ $('Draft Outreach').item.json.output }}"
      },
      "id": "c0000000-0000-4000-8000-000000000010",
      "name": "Send AI Email",
