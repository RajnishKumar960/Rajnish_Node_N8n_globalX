# Example environment variables. Copy to ".env" and fill in real values.
# NEVER commit a real .env file (it is git-ignored).

# --- Mock Company API (local development only) ---
MOCK_PORT=8088
MOCK_API_KEY=dev-key-local
MOCK_BEARER=dev-token-local

# --- n8n (if running n8n via its own process rather than docker-compose) ---
# N8N_CUSTOM_EXTENSIONS=E:\Custome Node\Rajnish_Node_N8n_globalX
# N8N_SECURE_COOKIE=false

# --- Company backend (CONFIRM with platform team; do NOT invent real values) ---
# These are consumed by the CompanyApi credential inside n8n, NOT by this repo.
# Documented here only so operators know what must be provisioned per environment:
# COMPANY_API_BASE_URL_DEV=
# COMPANY_API_BASE_URL_STAGING=
# COMPANY_API_BASE_URL_PROD=
# COMPANY_API_KEY=            # store in n8n credentials, never in plain env in prod
